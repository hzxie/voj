# Copy to .env and edit for docker-compose.yml. Compose reads .env automatically;
# VOJ_JUDGER_API_TOKEN and VOJ_JUDGER_PASSWORD are required, everything else is
# optional.

# Host address and port to publish the web UI on. The default address is the
# loopback interface, for a reverse proxy on the same host; 0.0.0.0 exposes it.
VOJ_HTTP_BIND=127.0.0.1
VOJ_HTTP_PORT=8080

# Public root used in e-mails and absolute links. Behind a reverse proxy set this
# to the externally visible URL, e.g. https://oj.example.edu, and set the context
# path to / to serve at the root.
VOJ_BASE_URL=http://localhost:8080/voj
VOJ_CONTEXT_PATH=/voj

# Shared secret the judger presents to download a problem's test data (the web and
# judger read the same one). Required, at least 16 characters: generate one with
# `openssl rand -hex 24`.
VOJ_JUDGER_API_TOKEN=

# The account the judger signs in as, and its password (6 to 64 characters). The web
# app makes this account a judger account with this password on every start, so
# changing the password here is enough. Required: generate one with
# `openssl rand -hex 24`. An installation whose judgers signed in as an account of
# its own (e.g. voj@judger) sets its name here.
VOJ_JUDGER_USERNAME=judger
VOJ_JUDGER_PASSWORD=

# 1 loads sample problems, contests and accounts (passwords = usernames, root / root
# is an administrator) on the first start, to try VOJ out. Otherwise the first
# start creates an administrator with a random password: `docker compose logs web`.
VOJ_DEMO=0

# SMTP (leave host empty to disable e-mail, e.g. password-reset mails).
VOJ_MAIL_HOST=
VOJ_MAIL_PORT=587
VOJ_MAIL_USERNAME=
VOJ_MAIL_PASSWORD=
VOJ_MAIL_SENDER=noreply@example.com
