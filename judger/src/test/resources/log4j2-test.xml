<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="OFF">
	<Properties>
		<Property name="patternLayout">[%p] %d [%t] %c - %m%n</Property>
	</Properties>
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="${patternLayout}" />
		</Console>
	</Appenders>
	<Loggers>
		<!-- Why the sandbox could not run a compiler, which the result of the compilation does
		     not say: a test that fails on it shows the cause. -->
		<Logger name="org.verwandlung.voj.judger.core.Compiler" level="ERROR" />
		<Root level="OFF">
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>